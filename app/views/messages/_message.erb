<% response = message.response %>
<% category_class =
  if response.present?
    case response.category
    when "Complaint"
      "border-rose-400/30 bg-rose-400/10 text-rose-200"
    when "Billing Issue"
      "border-amber-300/30 bg-amber-300/10 text-amber-100"
    when "Support Request"
      "border-sky-300/30 bg-sky-300/10 text-sky-100"
    when "New Client"
      "border-emerald-300/30 bg-emerald-300/10 text-emerald-100"
    when "Out of Scope"
      "border-zinc-400/30 bg-zinc-400/10 text-zinc-200"
    else
      "border-teal-300/30 bg-teal-300/10 text-teal-100"
    end
  end %>

<article class="space-y-4">
  <div class="flex justify-end">
    <div class="max-w-[85%] rounded-3xl bg-[#303030] px-5 py-4 text-sm leading-6 text-zinc-100 shadow-lg shadow-black/10">
      <p><%= message.content %></p>
      <time class="mt-2 block text-xs text-zinc-500"><%= message.created_at.strftime("%b %-d, %Y %I:%M %p") %></time>
    </div>
  </div>

  <div class="flex gap-3">
    <div class="mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white text-xs font-semibold text-slate-950">
      AI
    </div>

    <div class="min-w-0 flex-1">
      <% if response.present? %>
        <div class="mb-3 flex flex-wrap items-center gap-2">
          <span class="rounded-full border px-3 py-1 text-xs font-semibold <%= category_class %>">
            <%= response.category %>
          </span>
          <span class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-xs font-medium text-zinc-300">
            <%= response.confidence %>% confidence
          </span>
          <span class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-xs font-medium text-zinc-300">
            <%= response.sentiment %>
          </span>
        </div>

        <div class="rounded-3xl border border-white/10 bg-white/[0.04] p-5 shadow-xl shadow-black/10">
          <div class="grid gap-4">
            <section>
              <h3 class="text-sm font-semibold text-white">Summary</h3>
              <p class="mt-2 text-sm leading-6 text-zinc-300"><%= response.summary %></p>
            </section>

            <section class="rounded-2xl border border-teal-300/20 bg-teal-300/10 p-4">
              <h3 class="text-sm font-semibold text-teal-100">Recommended action</h3>
              <p class="mt-2 text-sm leading-6 text-teal-50"><%= response.recommended_action %></p>
            </section>

            <section>
              <h3 class="text-sm font-semibold text-white">Suggested response</h3>
              <div class="mt-2 rounded-2xl bg-[#303030] p-4 text-sm leading-6 text-zinc-200">
                <%= response.suggested_response %>
              </div>
            </section>
          </div>
        </div>
      <% else %>
        <div class="rounded-3xl border border-amber-300/20 bg-amber-300/10 px-5 py-4 text-sm text-amber-100">
          Awaiting AI analysis.
        </div>
      <% end %>
    </div>
  </div>
</article>
