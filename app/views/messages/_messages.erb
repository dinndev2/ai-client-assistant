<%= turbo_frame_tag "messages", class: "space-y-8", data: { controller: "auto-scroll" } do %>
  <% if messages.any? %>
    <%= render messages %>
  <% else %>
    <div class="flex gap-3">
      <div class="mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white text-xs font-semibold text-slate-950">
        AI
      </div>

      <div class="min-w-0 flex-1">
        <div class="rounded-3xl border border-white/10 bg-white/[0.04] p-5 text-sm leading-6 text-zinc-300 shadow-xl shadow-black/10">
          <div class="mb-3 inline-flex items-center gap-2 rounded-full border border-teal-300/20 bg-teal-300/10 px-3 py-1 text-xs font-semibold text-teal-100">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 3v3M12 18v3M4.6 5.6l2.1 2.1M17.3 16.3l2.1 2.1M3 12h3M18 12h3M4.6 18.4l2.1-2.1M17.3 7.7l2.1-2.1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
            Ready
          </div>
          <p class="text-zinc-200">Paste a client enquiry above or choose a recommended prompt.</p>
          <p class="mt-2 text-zinc-500">I will return the classification, confidence score, recommended staff action, and a suggested client reply here.</p>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
